@typeparam TWrite where TWrite : class, new()
@typeparam TRead where TRead : class, new()

<UniversalTable
    Items="Base.DataView"
    IsLoading="Base.IsLoading"
    EmptyMessage="@Base.EmptyMessage"
    CurrentPage="Base.CurrentPage"
    TotalPages="Base.TotalPages"
    TotalCount="Base.TotalCount"
    PageSize="Base.PageSize"
    OnPageChange="Base.ChangePage"
    Filters="Base.Filters"
    OnFilterChange="() => Base.RefreshData()"
    ClearFilters="Base.ClearAllFilters"
    OnSort="Base.ToggleSort"
    GetSortIcon="Base.GetSortIcon"
    OnPageSizeChange="Base.AlterPageSize"
    OnEdit="OnEdit"
    OnExpand="OnExpand"
    OnDownload="OnDownload"
    OnHistory="OnHistory"
    Target="Target"
    TargetStyle="@TargetStyle"
    OnSaveToCsv="Base.SaveToCSV"
    NoCsv="NoCsv" />

@code{
    [Parameter, EditorRequired]
    public TableManager<TWrite, TRead> Base { get; set; } = default!;

    [Parameter] public EventCallback<TRead> OnExpand { get; set; }
    [Parameter] public EventCallback<TRead> OnEdit { get; set; }
    [Parameter] public EventCallback<TRead> OnDownload { get; set; }
    [Parameter] public EventCallback<TRead> OnHistory { get; set; }
    [Parameter] public TRead? Target { get; set; }
    [Parameter] public string? TargetStyle { get; set; }
    [Parameter] public bool NoCsv { get; set; }
}
