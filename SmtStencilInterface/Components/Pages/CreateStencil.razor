@page "/create-stencil"
@inherits TableManager<Stencil, EnhancedStencil>

<PageTitle>Stencil Creation</PageTitle>

<h2>Create a New Stencil</h2>

<div class="expandable-container">
    <div class="expandable-wrapper @(IsFormVisible ? "is-expanded" : "")">
        <div class="expandable-content">
            <div class="form-card mb-3">
                <EditForm Model="@EditItem" OnValidSubmit="@(() => HandleValidSubmit())">
                    <DataAnnotationsValidator />
                    <div class="form-container">
                        <h5 class="form-title">Stencil Details</h5>
                        <div class="row g-3">
                            <div class="col-2">
                                <label for="name" class="form-label">Stencil Maker:</label>
                                <InputText id="name" @bind-Value="EditItem.Maker" class="form-control" autocomplete="off" />
                                <ValidationMessage For="@(() => EditItem.Maker)" />
                            </div>
                            <div class="col-2">
                                <label for="panelNum" class="form-label">Job Number:</label>
                                <InputText id="panelNum" @bind-Value="EditItem.JobNum" class="form-control" autocomplete="off" />
                                <ValidationMessage For="@(() => EditItem.JobNum)" />
                            </div>
                            <div class="col-2">
                                <label class="form-label">Date Received</label>
                                <input type="date"
                                    class="form-control"
                                    @bind="EditItem.ReceiveDate"
                                    max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
                                <ValidationMessage For="@(() => EditItem.ReceiveDate)" />
                            </div>
                            <div class="col-2">
                                <label for="cycle" class="form-label">Cycle Count:</label>
                                <InputNumber id="cycle" @bind-Value="EditItem.CycleCount" class="form-control" />
                                <ValidationMessage For="@(() => EditItem.CycleCount)" />
                            </div>
                            <div class="col-2">
                                <label for="thickness" class="form-label">Thickness (mm):</label>
                                <InputNumber id="thickness" @bind-Value="dummyThickness" @bind-Value:after="ResolveThickness" class="form-control" />
                                <ValidationMessage For="@(() => EditItem.Thickness)" />
                            </div>
                            <div class="col-2">
                                <label class="form-label">Expiration Date</label>
                                <input type="date"
                                    class="form-control"
                                    @bind="EditItem.ExpirationDate"
                                    min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
                                <ValidationMessage For="@(() => EditItem.ExpirationDate)" />
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-3">
                                <label for="model" class="form-label">Model Name:</label>
                                <InputText list="models" id="model" @bind-Value="targetModel" @bind-Value:after="ResolveModel" class="form-control" autocomplete="off" />
                                <datalist id="models">
                                    @foreach (string m in availableModels)
                                    {
                                        <option value="@m">@m</option>
                                    }
                                </datalist>
                                <ValidationMessage For="@(() => EditItem.ModelId)" />
                            </div>
                            <div class="col-3">
                                <label for="line" class="form-label">Location:</label>
                                <InputText list="lines" id="line" @bind-Value="EditItem.Location" class="form-control" autocomplete="off" />
                                <datalist id="lines">
                                    @foreach (string l in availableLines)
                                    {
                                        <option value="@l">@l</option>
                                    }
                                </datalist>
                                <ValidationMessage For="@(() => EditItem.Location)" />
                            </div>
                            <div class="col-3">
                                <label for="status" class="form-label">Status</label>
                                <select id="status" class="form-select" @bind="@targetStatus" @bind:after="ResolveStatus">
                                    <option value="">--Select a status--</option>
                                    @foreach(string s in availableStatuses)
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                                <ValidationMessage For="@(() => EditItem.StatusCode)" />
                            </div>
                            <div class="col-3">
                                <label for="note" class="form-label">Note:</label>
                                <InputText id="note" @bind-Value="EditItem.Note" class="form-control" autocomplete="off" />
                                <ValidationMessage For="@(() => EditItem.Note)" />
                            </div>
                        </div>

                        <div class="form-actions d-flex justify-content-center gap-4">
                            <button type="button" class="btn btn-outline-secondary btn-lg me-2" @onclick="CloseForm">Cancel</button>
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="bi bi-plus-lg"></i> Save Stencil
                            </button>
                        </div>
                    </div>
                </EditForm>
                <ErrorDisplay ErrorMessage="@ErrorMessage" />
            </div>
        </div>
    </div>

    <div class="expandable-wrapper @(!IsFormVisible ? "is-expanded" : "")">
        <div class="expandable-content">
            <div class="d-flex justify-content-center mb-3">
                <button class="btn btn-success" @onclick="ShowForm">
                    <i class="bi bi-plus-lg"></i> Add New Stencil
                </button>
            </div>
        </div>
    </div>
</div>

<TablePresenter TWrite="Stencil"
                TRead="EnhancedStencil"
                Base="this"
                Target="target"
                OnExpand="() => {}" />

